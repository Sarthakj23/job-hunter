# ---------------------------------------------------------------------------
# Google Gemini
# ---------------------------------------------------------------------------
# Get a key from https://aistudio.google.com/apikey
# GEMINI_API_KEY is what AI Studio gives you; GOOGLE_API_KEY is what
# langchain-google-genai reads. Set either — agent.py normalises between them.
GEMINI_API_KEY=AQ.Ab8RN6JckPJjSUshkNXkHLB7JC4CnTRTht576G8Heardq5Q-AQ
# GOOGLE_API_KEY=

# Scoring model — the judgement call the shortlist depends on.
# Stable options: gemini-3.7-flash, gemini-3.6-flash, gemini-3.5-flash
GEMINI_MODEL=gemini-3.6-flash

# Extraction model — resume parsing and search-result cleanup. Cheap is fine.
# Stable options: gemini-3.5-flash-lite, gemini-3.1-flash-lite
GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# Parallel scoring calls. The free tier's requests-per-minute ceiling is low;
# raise this on a paid key.
GEMINI_MAX_CONCURRENCY=3

# Set to 1 only if legitimate job descriptions are tripping Gemini's content
# filters (happens with security, defence and clinical roles).
GEMINI_RELAX_SAFETY=0

# ---------------------------------------------------------------------------
# Search
# ---------------------------------------------------------------------------
# Optional but strongly recommended — Tavily supports domain filtering, which is
# what keeps results on boards the applier can actually fill.
# Without it the graph falls back to DuckDuckGo.
TAVILY_API_KEY=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

# ---------------------------------------------------------------------------
# Playwright
# ---------------------------------------------------------------------------
JOB_HUNTER_ARTIFACTS=./artifacts
